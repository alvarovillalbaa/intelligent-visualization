NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provider selection
PERSISTENCE_PROVIDER=local
STORAGE_PROVIDER=auto
AUTH_PROVIDER=portable
REALTIME_PROVIDER=auto

# Portable authentication
AUTH_SECRET=
VISUALIZATION_SIGNING_SECRET=
API_KEY_PEPPER=

# Local
LOCAL_DATABASE_URL=postgresql://iv_local:iv_local@127.0.0.1:54431/intelligent_visualization
LOCAL_STORAGE_DIR=.data/storage

# Supabase (server only; provider acceptance and explicit provisioning required)
# Dedicated iv_runtime LOGIN, direct :5432 or transaction pooler :6543; no URL query options.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# One pre-created private bucket, scoped to this app. Do not use a public bucket.
SUPABASE_STORAGE_BUCKET=visualization-private

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI
AI_ENABLED=false
AI_GATEWAY_API_KEY=
AI_GENERATION_MODEL=
AI_PLANNING_MODEL=
AI_CRITIQUE_MODEL=

# Vercel agent stack
EVE_ENABLED=false
WORKFLOWS_ENABLED=true
QUEUES_ENABLED=false
SANDBOX_QA_ENABLED=false

# Optional extraction
FIRECRAWL_API_KEY=

# Limits
MAX_UPLOAD_MB=50
MAX_SOURCE_CHARACTERS=250000
MAX_GENERATION_REPAIR_ATTEMPTS=2
