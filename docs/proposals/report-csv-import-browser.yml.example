# INACTIVE. Explicit approval is required before temporary activation on main.
# Activation/removal commits use [skip actions]; remove after terminal inspection.
name: Temporary Report CSV import checks
on:
  workflow_dispatch:
    inputs:
      source_commit:
        description: Approved full source commit containing the reviewed inventory
        required: true
        type: string
permissions:
  contents: read
jobs:
  report-csv:
    if: github.repository == 'alvarovillalbaa/intelligent-visualization' && github.event.repository.private == false && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: ${{ inputs.source_commit }}
      CI: "true"
      NEXT_TELEMETRY_DISABLED: "1"
      DO_NOT_TRACK: "1"
      NEXT_PUBLIC_APP_URL: http://127.0.0.1:3100
      PERSISTENCE_PROVIDER: local
      STORAGE_PROVIDER: auto
      AUTH_PROVIDER: portable
      REALTIME_PROVIDER: auto
      AI_ENABLED: "false"
      EVE_ENABLED: "false"
      WORKFLOWS_ENABLED: "false"
      QUEUES_ENABLED: "false"
      SANDBOX_QA_ENABLED: "false"
      DATABASE_URL: ""
      CONVEX_URL: ""
      NEXT_PUBLIC_CONVEX_URL: ""
      CONVEX_DEPLOYMENT: ""
      CONVEX_DEPLOY_KEY: ""
      CONVEX_SERVER_TOKEN: ""
      CONVEX_ADMIN_KEY: ""
      SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_ANON_KEY: ""
      SUPABASE_SERVICE_ROLE_KEY: ""
      CLOUDFLARE_DATA_API_URL: ""
      CLOUDFLARE_DATA_API_SECRET: ""
      CLOUDFLARE_ACCOUNT_ID: ""
      CLOUDFLARE_API_TOKEN: ""
      CLOUDFLARE_D1_DATABASE_ID: ""
      CLOUDFLARE_R2_BUCKET: ""
      CLOUDFLARE_R2_ACCESS_KEY_ID: ""
      CLOUDFLARE_R2_SECRET_ACCESS_KEY: ""
      BLOB_READ_WRITE_TOKEN: ""
      AI_GATEWAY_API_KEY: ""
      VERCEL_OIDC_TOKEN: ""
      VERCEL: ""
      OPENAI_API_KEY: ""
      ANTHROPIC_API_KEY: ""
      GOOGLE_GENERATIVE_AI_API_KEY: ""
      FIRECRAWL_API_KEY: ""
    steps:
      - name: Validate the source pin
        run: '[[ "$SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]'
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ inputs.source_commit }}
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Verify all reviewed inputs and allocate owned runner paths
        run: |
          node <<'NODE'
          const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
          const seal=JSON.parse(fs.readFileSync('docs/results/2026/10-30/report-csv-import-source.json','utf8'));
          if(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim()!==process.env.SOURCE_COMMIT)throw Error('Source commit changed.');
          const tracked=cp.execFileSync('git',['ls-files','-z'],{encoding:'utf8'}).split('\0').filter(p=>p&&!seal.excluded_prefixes.some(prefix=>p.startsWith(prefix))).sort();
          const sealed=seal.source_files.map(entry=>entry.path).sort();
          if(new Set(sealed).size!==sealed.length||JSON.stringify(tracked)!==JSON.stringify(sealed))throw Error('Source input set changed.');
          for(const entry of seal.source_files){const stat=fs.lstatSync(entry.path),mode=stat.isSymbolicLink()?'120000':stat.isFile()?(stat.mode&0o111?'100755':'100644'):'unsupported',bytes=stat.isSymbolicLink()?Buffer.from(fs.readlinkSync(entry.path),'utf8'):fs.readFileSync(entry.path);if(mode!==entry.mode||bytes.length!==entry.bytes||crypto.createHash('sha256').update(bytes).digest('hex')!==entry.sha256)throw Error('Source seal mismatch: '+entry.path);}
          for(const [key,count]of [['csv_case_names',41],['authoring_case_names',44],['editor_case_names',19],['artifact_case_names',64],['browser_case_names',4],['browser_profiles',2]])if(seal[key].length!==count||new Set(seal[key]).size!==count)throw Error('Unexpected case manifest: '+key);
          if(JSON.stringify([...seal.browser_profiles].sort())!==JSON.stringify(['desktop','mobile']))throw Error('Unexpected browser profiles.');
          const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));
          if(process.version!=='v24.21.0'||pkg.dependencies.next!=='16.1.6'||pkg.dependencies['@playwright/test']||pkg.devDependencies['@playwright/test'])throw Error('Re-review changed runtime/tool baseline.');
          const temp=path.resolve(process.env.RUNNER_TEMP||'');
          if(!process.env.RUNNER_TEMP||!process.env.GITHUB_ENV||fs.realpathSync(temp)!==temp||fs.lstatSync(temp).isSymbolicLink()||!/^\d+$/.test(process.env.GITHUB_RUN_ID||'')||!/^\d+$/.test(process.env.GITHUB_RUN_ATTEMPT||''))throw Error('Missing canonical runner identity.');
          const root=fs.mkdtempSync(path.join(temp,'iv-report-csv-'+process.env.GITHUB_RUN_ID+'-'+process.env.GITHUB_RUN_ATTEMPT+'-'));
          const stat=fs.statSync(root);fs.writeFileSync(path.join(root,'owner.json'),JSON.stringify({root,dev:stat.dev,ino:stat.ino}));
          fs.appendFileSync(process.env.GITHUB_ENV,[['IV_REPORT_CSV_ROOT',root],['IV_REPORT_CSV_TOOLS',path.join(root,'tools')],['PLAYWRIGHT_BROWSERS_PATH',path.join(root,'browsers')],['IV_REPORT_CSV_OUTPUT',path.join(root,'output')],['IV_REPORT_CSV_BROWSER_RESULTS',path.join(root,'browser-results.json')],['npm_config_cache',path.join(root,'npm-cache')],['NODE_PATH',path.join(root,'tools','node_modules')]].map(([k,v])=>k+'='+v).join('\n')+'\n');
          console.log(JSON.stringify({source:process.env.SOURCE_COMMIT,node:process.version,sourceFiles:sealed.length,unitCases:168,browserCases:8,inventorySha256:crypto.createHash('sha256').update(fs.readFileSync('docs/results/2026/10-30/report-csv-import-source.json')).digest('hex')}));
          NODE
      - name: Install locked app dependencies and runner-only Chromium tooling
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npm install --prefix "$IV_REPORT_CSV_TOOLS" --no-save --package-lock=false --ignore-scripts --no-audit --no-fund @playwright/test@1.58.2
          node -e 'const p=require(process.env.IV_REPORT_CSV_TOOLS+"/node_modules/@playwright/test/package.json");if(p.version!=="1.58.2")throw Error("Unexpected runner-only Playwright version");console.log("Playwright "+p.version)'
          git diff --exit-code -- package.json package-lock.json
          node "$IV_REPORT_CSV_TOOLS/node_modules/@playwright/test/cli.js" install --with-deps chromium
      - name: Run exactly 168 selected unit cases
        id: units
        run: |
          node node_modules/vitest/vitest.mjs run tests/unit/report-csv-import.test.ts tests/unit/report-authoring.test.ts tests/unit/report-editor.test.ts tests/unit/report-artifact.test.ts --maxWorkers=1 --no-file-parallelism --retry=0 --reporter=tap --reporter=json --outputFile.json="$IV_REPORT_CSV_ROOT/unit-results.json"
      - name: Materialize only the approved browser examples
        run: |
          node <<'NODE'
          const fs=require('node:fs'),path=require('node:path'),root=process.env.IV_REPORT_CSV_ROOT;
          if(fs.existsSync('tests/tmp')&&(!fs.lstatSync('tests/tmp').isDirectory()||fs.lstatSync('tests/tmp').isSymbolicLink()))throw Error('Unsafe test copy directory.');
          fs.mkdirSync('tests/tmp',{recursive:true});
          const copies=[['docs/proposals/report-csv-import-browser.test.ts.example','tests/tmp/report-csv-import.spec.ts'],['docs/proposals/report-csv-import-browser.config.ts.example','tests/tmp/report-csv-import.config.ts']],owned=[];
          for(const [source,target]of copies){fs.copyFileSync(source,target,fs.constants.COPYFILE_EXCL);const stat=fs.lstatSync(target);owned.push({path:target,dev:stat.dev,ino:stat.ino});fs.writeFileSync(path.join(root,'copies.json'),JSON.stringify(owned));}
          NODE
      - name: Run exactly eight desktop and narrow browser cases
        id: browser
        run: node "$IV_REPORT_CSV_TOOLS/node_modules/@playwright/test/cli.js" test --config tests/tmp/report-csv-import.config.ts
      - name: Verify exact outcomes and unchanged reviewed source
        if: always()
        env:
          UNIT_OUTCOME: ${{ steps.units.outcome }}
          BROWSER_OUTCOME: ${{ steps.browser.outcome }}
        run: |
          node <<'NODE'
          const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),cp=require('node:child_process');
          const seal=JSON.parse(fs.readFileSync('docs/results/2026/10-30/report-csv-import-source.json','utf8'));
          if(cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim()!==process.env.SOURCE_COMMIT)throw Error('Source identity changed.');
          const tracked=cp.execFileSync('git',['ls-files','-z'],{encoding:'utf8'}).split('\0').filter(p=>p&&!seal.excluded_prefixes.some(prefix=>p.startsWith(prefix))).sort();
          if(JSON.stringify(tracked)!==JSON.stringify(seal.source_files.map(e=>e.path).sort()))throw Error('Source file set changed.');
          for(const entry of seal.source_files){const stat=fs.lstatSync(entry.path),mode=stat.isSymbolicLink()?'120000':stat.isFile()?(stat.mode&0o111?'100755':'100644'):'unsupported',bytes=stat.isSymbolicLink()?Buffer.from(fs.readlinkSync(entry.path),'utf8'):fs.readFileSync(entry.path);if(mode!==entry.mode||bytes.length!==entry.bytes||crypto.createHash('sha256').update(bytes).digest('hex')!==entry.sha256)throw Error('Source changed: '+entry.path);}
          if(!process.env.IV_REPORT_CSV_ROOT)throw Error('Checks did not reach preparation.');
          const read=name=>{const file=path.join(process.env.IV_REPORT_CSV_ROOT,name),stat=fs.lstatSync(file);if(!stat.isFile()||stat.isSymbolicLink()||stat.size>2097152)throw Error('Missing or oversized outcome: '+name);return JSON.parse(fs.readFileSync(file,'utf8'));};
          const report=read('unit-results.json'),expected=new Map([['report-csv-import.test.ts',seal.csv_case_names],['report-authoring.test.ts',seal.authoring_case_names],['report-editor.test.ts',seal.editor_case_names],['report-artifact.test.ts',seal.artifact_case_names]]);
          const seen=new Set(),unitCases=[];let valid=true;
          for(const suite of report.testResults||[]){const file=path.basename(suite.name),names=(suite.assertionResults||[]).map(item=>item.fullName);if(seen.has(file)||!expected.has(file)||JSON.stringify([...names].sort())!==JSON.stringify([...(expected.get(file)||[])].sort())||new Set(names).size!==names.length)valid=false;seen.add(file);for(const item of suite.assertionResults||[])unitCases.push({file,name:item.fullName,status:item.status});}
          console.log(JSON.stringify({kind:'report-csv-unit-outcomes',source:process.env.SOURCE_COMMIT,total:report.numTotalTests,passed:report.numPassedTests,failed:report.numFailedTests,pending:report.numPendingTests,todo:report.numTodoTests,cases:unitCases}));
          if(process.env.UNIT_OUTCOME!=='success'||!valid||seen.size!==4||report.success!==true||report.numTotalTests!==168||report.numPassedTests!==168||report.numFailedTests!==0||report.numPendingTests!==0||report.numTodoTests!==0||unitCases.length!==168||unitCases.some(item=>item.status!=='passed'))throw Error('The 168 unit cases did not all pass.');
          const browser=read('browser-results.json'),cases=[];
          function visit(suites){for(const suite of suites||[]){for(const spec of suite.specs||[])for(const test of spec.tests||[])cases.push({title:spec.title,project:test.projectName,expected:test.expectedStatus,status:test.status,results:(test.results||[]).map(item=>({status:item.status,retry:item.retry}))});visit(suite.suites);}}
          visit(browser.suites);const pairs=cases.map(item=>item.project+':'+item.title).sort(),approved=seal.browser_profiles.flatMap(profile=>seal.browser_case_names.map(name=>profile+':'+name)).sort();
          console.log(JSON.stringify({kind:'report-csv-browser-outcomes',source:process.env.SOURCE_COMMIT,stats:browser.stats,cases,errors:browser.errors}));
          if(process.env.BROWSER_OUTCOME!=='success'||JSON.stringify(pairs)!==JSON.stringify(approved)||new Set(pairs).size!==8||(browser.errors||[]).length||browser.stats.expected!==8||browser.stats.unexpected||browser.stats.flaky||browser.stats.skipped||cases.some(item=>item.expected!=='passed'||item.status!=='expected'||item.results.length!==1||item.results[0].status!=='passed'||item.results[0].retry!==0))throw Error('The eight browser cases did not all pass exactly once.');
          NODE
      - name: Remove only identity-checked owned files and tooling
        if: always()
        run: |
          node <<'NODE'
          const fs=require('node:fs'),path=require('node:path'),root=process.env.IV_REPORT_CSV_ROOT;
          if(!root){console.log('No task root allocated.');process.exit(0);}
          const temp=path.resolve(process.env.RUNNER_TEMP||''),stat=fs.lstatSync(root),owner=JSON.parse(fs.readFileSync(path.join(root,'owner.json'),'utf8'));
          if(!stat.isDirectory()||stat.isSymbolicLink()||path.dirname(root)!==temp||fs.realpathSync(temp)!==temp||!path.basename(root).startsWith('iv-report-csv-'+process.env.GITHUB_RUN_ID+'-'+process.env.GITHUB_RUN_ATTEMPT+'-')||owner.root!==root||owner.dev!==stat.dev||owner.ino!==stat.ino)throw Error('Refusing unowned temporary cleanup.');
          const failures=[],file=path.join(root,'copies.json');
          for(const entry of fs.existsSync(file)?JSON.parse(fs.readFileSync(file,'utf8')):[]){try{if(!['tests/tmp/report-csv-import.spec.ts','tests/tmp/report-csv-import.config.ts'].includes(entry.path))throw Error('Unknown copied path');const folder=fs.lstatSync('tests/tmp');if(!folder.isDirectory()||folder.isSymbolicLink()||fs.realpathSync('tests/tmp')!==path.resolve('tests/tmp'))throw Error('Copied directory ownership changed');if(!fs.existsSync(entry.path))continue;const current=fs.lstatSync(entry.path);if(!current.isFile()||current.isSymbolicLink()||current.dev!==entry.dev||current.ino!==entry.ino)throw Error('Copied file ownership changed');fs.unlinkSync(entry.path);}catch(error){failures.push(String(error));}}
          fs.rmSync(root,{recursive:true});
          if(failures.length)throw Error(failures.join('; '));
          console.log('Owned Report CSV tooling/output and copied files removed.');
          NODE
