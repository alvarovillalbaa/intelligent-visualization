# INACTIVE. After explicit approval only, copy to
# .github/workflows/course-editor-browser.yml, commit with [skip actions], dispatch
# once, then remove that active workflow even if the run fails. No existing CI edit.
name: Temporary Course editor browser checks
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  course-editor:
    if: github.repository == 'alvarovillalbaa/intelligent-visualization' && github.event.repository.private == false && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      CI: "true"
      NEXT_TELEMETRY_DISABLED: "1"
      DO_NOT_TRACK: "1"
      NEXT_PUBLIC_APP_URL: http://127.0.0.1:3100
      PERSISTENCE_PROVIDER: local
      STORAGE_PROVIDER: auto
      AUTH_PROVIDER: portable
      REALTIME_PROVIDER: auto
      AI_ENABLED: "false"
      EVE_ENABLED: "false"
      WORKFLOWS_ENABLED: "false"
      QUEUES_ENABLED: "false"
      SANDBOX_QA_ENABLED: "false"
      DATABASE_URL: ""
      CONVEX_URL: ""
      NEXT_PUBLIC_CONVEX_URL: ""
      CONVEX_DEPLOYMENT: ""
      CONVEX_DEPLOY_KEY: ""
      CONVEX_SERVER_TOKEN: ""
      CONVEX_ADMIN_KEY: ""
      SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_ANON_KEY: ""
      SUPABASE_SERVICE_ROLE_KEY: ""
      CLOUDFLARE_DATA_API_URL: ""
      CLOUDFLARE_DATA_API_SECRET: ""
      CLOUDFLARE_ACCOUNT_ID: ""
      CLOUDFLARE_API_TOKEN: ""
      CLOUDFLARE_D1_DATABASE_ID: ""
      CLOUDFLARE_R2_BUCKET: ""
      CLOUDFLARE_R2_ACCESS_KEY_ID: ""
      CLOUDFLARE_R2_SECRET_ACCESS_KEY: ""
      BLOB_READ_WRITE_TOKEN: ""
      AI_GATEWAY_API_KEY: ""
      VERCEL_OIDC_TOKEN: ""
      VERCEL: ""
      OPENAI_API_KEY: ""
      ANTHROPIC_API_KEY: ""
      GOOGLE_GENERATIVE_AI_API_KEY: ""
      FIRECRAWL_API_KEY: ""
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Record source and verify the reviewed runtime and selection
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
          if (process.version !== 'v24.21.0' || pkg.dependencies.next !== '16.1.6') throw new Error('Re-review changed runtime versions.');
          if (pkg.dependencies['@playwright/test'] || pkg.devDependencies['@playwright/test']) throw new Error('The browser tool must remain runner-only.');
          const spec = fs.readFileSync('docs/proposals/course-editor-browser.test.ts.example', 'utf8');
          if ((spec.match(/^test\(/gm) || []).length !== 3) throw new Error('Expected exactly three scenarios, expanded over two projects.');
          NODE
          git rev-parse HEAD
          sha256sum package.json package-lock.json components/visualizations/composer.tsx components/visualizations/generation-results.tsx components/visualizations/preview.tsx components/visualizations/course-editor.tsx components/visualizations/course-editor/* lib/client/course-authoring.ts lib/client/guest-draft.ts components/visualizations/renderers/course-preview.tsx docs/proposals/course-editor-browser*
      - name: Allocate disposable runner paths
        run: |
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          if (!process.env.RUNNER_TEMP || !process.env.GITHUB_ENV) throw new Error('Missing runner paths.');
          const root = path.join(process.env.RUNNER_TEMP, 'iv-course-editor-' + process.env.GITHUB_RUN_ID + '-' + process.env.GITHUB_RUN_ATTEMPT);
          fs.mkdirSync(root, { recursive: false });
          fs.appendFileSync(process.env.GITHUB_ENV, [
            'IV_COURSE_RUN_ROOT=' + root,
            'IV_COURSE_TOOL_PREFIX=' + path.join(root, 'tools'),
            'PLAYWRIGHT_BROWSERS_PATH=' + path.join(root, 'browsers'),
            'IV_COURSE_OUTPUT=' + path.join(root, 'output'),
            'NODE_PATH=' + path.join(root, 'tools', 'node_modules'),
          ].join('\n') + '\n');
          NODE
      - name: Install locked application dependencies and the isolated pinned browser tool
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npm install --prefix "$IV_COURSE_TOOL_PREFIX" --no-save --package-lock=false --ignore-scripts --no-audit --no-fund @playwright/test@1.58.2
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          const pkg = JSON.parse(fs.readFileSync(path.join(process.env.IV_COURSE_TOOL_PREFIX, 'node_modules/@playwright/test/package.json'), 'utf8'));
          if (pkg.version !== '1.58.2') throw new Error('Unexpected browser tool version.');
          console.log('Runner-only @playwright/test ' + pkg.version);
          NODE
          git diff --exit-code -- package.json package-lock.json
          node "$IV_COURSE_TOOL_PREFIX/node_modules/@playwright/test/cli.js" install --with-deps chromium
      - name: Materialize only these approved examples in the disposable checkout
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          if (!process.env.GITHUB_ENV) throw new Error('Missing runner environment file.');
          const copies = [
            ['docs/proposals/course-editor-browser.test.ts.example', 'tests/tmp/course-editor.spec.ts', 'IV_COURSE_SPEC_COPIED'],
            ['docs/proposals/course-editor-browser.config.ts.example', 'tests/tmp/course-editor.config.ts', 'IV_COURSE_CONFIG_COPIED'],
          ];
          if (copies.some(([, target]) => fs.existsSync(target))) throw new Error('Refusing to replace existing test files.');
          fs.mkdirSync('tests/tmp', { recursive: true });
          for (const [source, target, flag] of copies) {
            fs.copyFileSync(source, target, fs.constants.COPYFILE_EXCL);
            fs.appendFileSync(process.env.GITHUB_ENV, flag + '=true\n');
          }
          NODE
      - name: Run only six Course editor Chromium checks
        run: node "$IV_COURSE_TOOL_PREFIX/node_modules/@playwright/test/cli.js" test --config tests/tmp/course-editor.config.ts
      - name: Remove runner-owned copied examples and tools, including after failure
        if: always()
        run: |
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          for (const [file, flag] of [['tests/tmp/course-editor.spec.ts', 'IV_COURSE_SPEC_COPIED'], ['tests/tmp/course-editor.config.ts', 'IV_COURSE_CONFIG_COPIED']]) {
            if (process.env[flag] === 'true') fs.rmSync(file, { force: true });
          }
          const root = process.env.IV_COURSE_RUN_ROOT;
          if (root) {
            if (path.dirname(root) !== process.env.RUNNER_TEMP || !path.basename(root).startsWith('iv-course-editor-')) throw new Error('Refusing unowned cleanup path.');
            fs.rmSync(root, { recursive: true, force: true });
          }
          NODE
