# INACTIVE. Only after separate explicit approval, copy to
# .github/workflows/report-export-browser.yml and dispatch once. Remove the active
# workflow even on failure, using [skip actions] in activation/cleanup commits.
name: Temporary Report export browser checks
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  report-export:
    if: github.repository == 'alvarovillalbaa/intelligent-visualization' && github.event.repository.private == false && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      CI: "true"
      NEXT_TELEMETRY_DISABLED: "1"
      DO_NOT_TRACK: "1"
      NEXT_PUBLIC_APP_URL: http://127.0.0.1:3100
      PERSISTENCE_PROVIDER: local
      STORAGE_PROVIDER: auto
      AUTH_PROVIDER: portable
      REALTIME_PROVIDER: auto
      AI_ENABLED: "false"
      EVE_ENABLED: "false"
      WORKFLOWS_ENABLED: "false"
      QUEUES_ENABLED: "false"
      SANDBOX_QA_ENABLED: "false"
      DATABASE_URL: ""
      CONVEX_URL: ""
      NEXT_PUBLIC_CONVEX_URL: ""
      CONVEX_DEPLOYMENT: ""
      CONVEX_DEPLOY_KEY: ""
      CONVEX_SERVER_TOKEN: ""
      CONVEX_ADMIN_KEY: ""
      SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_URL: ""
      NEXT_PUBLIC_SUPABASE_ANON_KEY: ""
      SUPABASE_SERVICE_ROLE_KEY: ""
      CLOUDFLARE_DATA_API_URL: ""
      CLOUDFLARE_DATA_API_SECRET: ""
      CLOUDFLARE_ACCOUNT_ID: ""
      CLOUDFLARE_API_TOKEN: ""
      CLOUDFLARE_D1_DATABASE_ID: ""
      CLOUDFLARE_R2_BUCKET: ""
      CLOUDFLARE_R2_ACCESS_KEY_ID: ""
      CLOUDFLARE_R2_SECRET_ACCESS_KEY: ""
      BLOB_READ_WRITE_TOKEN: ""
      AI_GATEWAY_API_KEY: ""
      VERCEL_OIDC_TOKEN: ""
      VERCEL: ""
      OPENAI_API_KEY: ""
      ANTHROPIC_API_KEY: ""
      GOOGLE_GENERATIVE_AI_API_KEY: ""
      FIRECRAWL_API_KEY: ""
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Record source and check the approved runtime and selection
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
          if (process.version !== 'v24.21.0' || pkg.dependencies.next !== '16.1.6') throw new Error('Re-review changed runtime versions.');
          if (pkg.dependencies['@playwright/test'] || pkg.devDependencies['@playwright/test']) throw new Error('The browser tool must remain runner-only.');
          const spec = fs.readFileSync('docs/proposals/report-export-browser.test.ts.example', 'utf8');
          if ((spec.match(/^test\(/gm) || []).length !== 2) throw new Error('Expected exactly two scenarios, expanded over two projects.');
          NODE
          git rev-parse HEAD
          sha256sum package.json package-lock.json app/api/visualizations/artifact/route.ts components/visualizations/preview.tsx components/visualizations/report-download.tsx lib/client/report-download.ts lib/client/report-authoring.ts lib/client/report-grid.ts lib/artifacts/compiler.ts lib/artifacts/report-grid.ts lib/artifacts/report-chart.ts packages/domain/schemas.ts docs/proposals/report-export-browser*
      - name: Allocate isolated runner paths
        run: |
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          if (!process.env.RUNNER_TEMP || !process.env.GITHUB_ENV) throw new Error('Missing runner paths.');
          const root = path.join(process.env.RUNNER_TEMP, 'iv-report-export-' + process.env.GITHUB_RUN_ID + '-' + process.env.GITHUB_RUN_ATTEMPT);
          fs.mkdirSync(root, { recursive: false });
          fs.appendFileSync(process.env.GITHUB_ENV, [
            'IV_EXPORT_RUN_ROOT=' + root,
            'IV_EXPORT_TOOL_PREFIX=' + path.join(root, 'tools'),
            'PLAYWRIGHT_BROWSERS_PATH=' + path.join(root, 'browsers'),
            'IV_EXPORT_OUTPUT=' + path.join(root, 'output'),
            'IV_EXPORT_DOWNLOADS=' + path.join(root, 'downloads'),
            'npm_config_cache=' + path.join(root, 'npm-cache'),
            'NODE_PATH=' + path.join(root, 'tools', 'node_modules'),
          ].join('\n') + '\n');
          NODE
      - name: Install locked application dependencies and isolated browser tooling
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npm install --prefix "$IV_EXPORT_TOOL_PREFIX" --no-save --package-lock=false --ignore-scripts --no-audit --no-fund @playwright/test@1.58.2
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          const pkg = JSON.parse(fs.readFileSync(path.join(process.env.IV_EXPORT_TOOL_PREFIX, 'node_modules/@playwright/test/package.json'), 'utf8'));
          if (pkg.version !== '1.58.2') throw new Error('Unexpected browser tool version.');
          console.log('Runner-only @playwright/test ' + pkg.version);
          NODE
          git diff --exit-code -- package.json package-lock.json
          node "$IV_EXPORT_TOOL_PREFIX/node_modules/@playwright/test/cli.js" install --with-deps chromium
      - name: Materialize only these approved examples
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          if (!process.env.GITHUB_ENV) throw new Error('Missing runner environment file.');
          const copies = [
            ['docs/proposals/report-export-browser.test.ts.example', 'tests/tmp/report-export.spec.ts', 'IV_EXPORT_SPEC_COPIED'],
            ['docs/proposals/report-export-browser.config.ts.example', 'tests/tmp/report-export.config.ts', 'IV_EXPORT_CONFIG_COPIED'],
          ];
          if (copies.some(([, target]) => fs.existsSync(target))) throw new Error('Refusing to replace existing test files.');
          fs.mkdirSync('tests/tmp', { recursive: true });
          for (const [source, target, flag] of copies) {
            fs.copyFileSync(source, target, fs.constants.COPYFILE_EXCL);
            fs.appendFileSync(process.env.GITHUB_ENV, flag + '=true\n');
          }
          NODE
      - name: Run only four Report export checks
        run: node "$IV_EXPORT_TOOL_PREFIX/node_modules/@playwright/test/cli.js" test --config tests/tmp/report-export.config.ts
      - name: Remove owned files and tooling, including after failure
        if: always()
        run: |
          node <<'NODE'
          const fs = require('node:fs'), path = require('node:path');
          for (const [file, flag] of [['tests/tmp/report-export.spec.ts', 'IV_EXPORT_SPEC_COPIED'], ['tests/tmp/report-export.config.ts', 'IV_EXPORT_CONFIG_COPIED']]) {
            if (process.env[flag] === 'true') fs.rmSync(file, { force: true });
          }
          const root = process.env.IV_EXPORT_RUN_ROOT;
          if (root) {
            if (path.dirname(root) !== process.env.RUNNER_TEMP || !path.basename(root).startsWith('iv-report-export-')) throw new Error('Refusing unowned cleanup path.');
            fs.rmSync(root, { recursive: true, force: true });
          }
          NODE
