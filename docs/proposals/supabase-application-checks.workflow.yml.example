# Inactive. Pin both the passing provider receipt and reviewed source before use.
name: Temporary Supabase application checks 7
on:
  create:
permissions:
  contents: read
jobs:
  supabase-application:
    if: github.repository == 'alvarovillalbaa/intelligent-visualization' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/supabase-application-20261107-7' && github.ref == 'refs/heads/qa/supabase-application-20261107-7'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: APPROVED_SOURCE_COMMIT
      IV_SUPABASE_APPLICATION_PUBLIC_REPOSITORY: ${{ github.event.repository.private == false }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          fetch-depth: 1
          clean: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          cache: ''
      - name: Check real selected factories and four owned application journeys
        run: python3 scripts/supabase-application-checks.py
