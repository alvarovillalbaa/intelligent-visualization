// INACTIVE. Separate browser, targeted-backend and temporary-CI approval required.
// Copy only in that runner to tests/tmp/course-export.spec.ts; relative imports depend on it.
// The anonymous root still imports application modules/in-memory demo seeds. No
// session cookie means getCurrentSessionUser returns before a repository lookup.
import { createHash } from "node:crypto"
import { mkdtempSync, mkdirSync, readFileSync, rmSync } from "node:fs"
import path from "node:path"
import { pathToFileURL } from "node:url"
import { expect, test, type Browser, type BrowserContext, type Download, type Locator, type Page, type TestInfo } from "@playwright/test"

import type { GeneratedDraft } from "../../lib/client/guest-draft"
import type { CourseVisualizationDocument } from "../../packages/domain/entities"
import { createStarterCourseDocument } from "../../packages/domain/fixtures"

const ORIGIN = "http://127.0.0.1:3100"
const KEY = "iv:guest-draft:v2"
const SOURCE = "Authored Course export check. No real source, URL, account or model request."
const TITLE = "Authored / Course: Résumé?"
const FILENAME = "course-authored-course-resume.html"
const MODULE_ID = 'module\"<authored>'
const FIRST_LESSON = 'lesson\"<first>'
const QUIZ_ID = 'quiz\"<authored>'
type Harness = {
  authored: CourseVisualizationDocument; unexpected: string[]; pageErrors: string[];
  generation: number; artifacts: number; actualArtifacts: number; mocked503: number; failFirst: boolean;
  downloads: Download[]; fileContexts: BrowserContext[]; directories: string[]; blobs: Set<string>;
}
const harnesses = new WeakMap<BrowserContext, Harness>()

function fixture(): GeneratedDraft {
  const document = createStarterCourseDocument()
  document.title = TITLE
  document.subtitle = "Authored standalone Course subtitle"
  document.summary = "Authored Course summary."
  document.audience = "Authored learner audience"
  document.goal = "Authored course-level goal"
  document.seo = { title: TITLE, description: "Authored Course SEO description" }
  document.sourceManifest = [{ id: "authored-source", label: "Authored Course source", kind: "paste", contentHash: "authored-course-source-hash", provenance: "Authored source provenance, not verification." }]
  document.course = {
    mission: "Authored learning mission", estimatedMinutes: 13,
    learnerProfile: { level: "intermediate", assumedKnowledge: ["Authored assumed knowledge"], goals: ["Authored learner goal"], constraints: ["Authored learner constraint"] },
    learningObjectives: ["Authored learning objective"], prerequisites: ["Authored course prerequisite"],
    modules: [{ id: MODULE_ID, title: "Authored module", objective: "Authored module objective", lessons: [
      { id: FIRST_LESSON, title: "Authored foundations lesson", objective: "Authored first lesson objective", estimatedMinutes: 5, prerequisiteIds: [],
        explanation: "Authored first explanation", feedback: "Authored first lesson feedback", summary: "Authored first lesson summary", references: ["reference-record", "RFC notes supplied as plain citation"],
        blocks: [
          { id: "heading-record", kind: "heading", text: "Authored block heading" },
          { id: "prose-record", kind: "prose", text: "Authored prose with <literal> text." },
          { id: "callout-record", kind: "callout", title: "Authored callout title", body: "Authored callout body" },
          { id: QUIZ_ID, kind: "multiple-choice-check", prompt: "Choose the authored answer", options: ["Wrong authored choice", "Right authored choice"], answerIndex: 1, explanation: "Authored answer explanation" },
          { id: "recall-record", kind: "free-recall-check", prompt: "Explain the authored concept", guidance: "Authored recall guidance" },
          { id: "summary-record", kind: "summary", items: ["Authored block takeaway"] },
        ], practice: [{ id: "practice-record", kind: "prose", text: "Authored practice task" }],
      },
      { id: "second-lesson", title: "Authored follow-up lesson", objective: "Authored second lesson objective", estimatedMinutes: 8, prerequisiteIds: [FIRST_LESSON],
        explanation: "Authored second explanation", blocks: [], practice: [], feedback: "Authored second lesson feedback", summary: "Authored second lesson summary", references: [],
      },
    ] }],
    glossary: [{ id: "glossary-record", term: "Authored glossary term", definition: "Authored glossary definition" }],
    references: [{ id: "reference-record", title: "Authored linked reference", href: "https://example.invalid/authored-reference?source=course", note: "Authored reference qualification" }],
  }
  return { kind: "course", document, provider: "authored-browser-mock", modelName: "course-export-fixture", generatedAt: Date.now(), deckSource: null, artifactHtml: null }
}

function canonical(value: unknown): string {
  function ordered(entry: unknown): unknown {
    if (Array.isArray(entry)) return entry.map(ordered)
    if (entry && typeof entry === "object") return Object.fromEntries(Object.entries(entry).sort(([a], [b]) => a.localeCompare(b)).map(([key, item]) => [key, ordered(item)]))
    return entry
  }
  return JSON.stringify(ordered(value))
}
function ownedDownloadRoot(): string {
  const root = process.env.IV_COURSE_RUN_ROOT, runner = process.env.RUNNER_TEMP, downloads = process.env.IV_COURSE_DOWNLOADS
  if (!root || !runner || !downloads || path.dirname(root) !== path.resolve(runner) || !/^iv-course-export-\d+-\d+$/.test(path.basename(root)) || downloads !== path.join(root, "downloads")) throw new Error("Refusing unowned download paths")
  return downloads
}

test.beforeEach(async ({ context, page, baseURL }) => {
  expect(baseURL).toBe(ORIGIN); expect(await context.cookies()).toEqual([])
  const authored = fixture()
  if (authored.document.kind !== "course") throw new Error("Expected authored Course")
  const state: Harness = { authored: authored.document, unexpected: [], pageErrors: [], generation: 0, artifacts: 0, actualArtifacts: 0, mocked503: 0, failFirst: false, downloads: [], fileContexts: [], directories: [], blobs: new Set() }
  harnesses.set(context, state)
  page.on("pageerror", (error) => state.pageErrors.push(error.message))
  page.on("download", (download) => state.downloads.push(download))
  await context.route("**/*", async (route) => {
    const request = route.request(), url = new URL(request.url())
    if (url.protocol === "blob:" && state.blobs.has(request.url()) && ["GET", "HEAD"].includes(request.method())) { await route.continue(); return }
    if (url.origin !== ORIGIN) { state.unexpected.push(`${request.method()} ${url.origin}${url.pathname}`); await route.abort("blockedbyclient"); return }
    if (request.method() === "POST" && url.pathname === "/api/visualizations/generate") {
      const body = request.postDataJSON() as { kind?: string; generationInput?: { rawText?: string } }
      if (body.kind !== "course" || body.generationInput?.rawText !== SOURCE) {
        state.unexpected.push("Unexpected generation payload"); await route.abort("blockedbyclient"); return
      }
      state.generation++; await route.fulfill({ status: 200, json: structuredClone(authored) }); return
    }
    if (request.method() === "POST" && url.pathname === "/api/visualizations/artifact") {
      if (canonical(request.postDataJSON()) !== canonical({ document: state.authored })) {
        state.unexpected.push("Unexpected artifact payload"); await route.abort("blockedbyclient"); return
      }
      state.artifacts++
      if (state.failFirst && state.artifacts === 1) { state.mocked503++; await route.fulfill({ status: 503, json: { error: "Authored first-attempt failure." } }); return }
      state.actualArtifacts++; await route.continue(); return // Actual approved LOCAL route, never a compiled HTML fixture.
    }
    if (!["GET", "HEAD"].includes(request.method()) || !(url.pathname === "/" || url.pathname.startsWith("/_next/") || url.pathname === "/favicon.ico")) {
      state.unexpected.push(`${request.method()} ${url.pathname}`); await route.abort("blockedbyclient"); return
    }
    await route.continue()
  })
})

test.afterEach(async ({ context, page }) => {
  const state = harnesses.get(context)
  if (!state) return
  const closed = await Promise.allSettled([page.close(), ...state.fileContexts.map((file) => file.close())])
  try {
    expect(state.unexpected, "No unexpected API, navigation, runtime write or external request").toEqual([])
    expect(state.pageErrors).toEqual([]); expect(state.generation).toBe(1); expect(state.actualArtifacts).toBe(1)
    expect(state.artifacts).toBe(state.failFirst ? 2 : 1); expect(state.mocked503).toBe(state.failFirst ? 1 : 0)
  } finally {
    const outcomes = [...closed, ...await Promise.allSettled(state.downloads.map((download) => download.delete()))]
    const root = ownedDownloadRoot()
    for (const directory of state.directories) {
      if (path.dirname(directory) !== root || !/^(desktop|mobile)-/.test(path.basename(directory))) throw new Error("Refusing unowned saved-file cleanup")
      rmSync(directory, { recursive: true, force: true })
    }
    const rejected = outcomes.filter((result): result is PromiseRejectedResult => result.status === "rejected")
    if (rejected.length) throw new AggregateError(rejected.map((result) => result.reason), "Owned browser-file cleanup failed")
  }
})

const downloadUI = (page: Page) => page.locator('[aria-label="Course HTML download"]')
async function activate(control: Locator, mobile: boolean) { if (mobile) await control.tap(); else await control.click() }
async function stored(page: Page): Promise<string | null> { return page.evaluate((key) => localStorage.getItem(key), KEY) }
async function generateAndOpen(page: Page, mobile: boolean) {
  await page.goto("/")
  await page.getByRole("textbox", { name: "Text or link", exact: true }).fill(SOURCE)
  await page.getByRole("button", { name: "Continue", exact: true }).click()
  const formats = page.getByRole("group", { name: "Draft formats", exact: true })
  await formats.getByRole("button", { name: /^Slides deck\b/ }).click()
  await formats.getByRole("button", { name: /^Course\b/ }).click()
  await page.getByRole("button", { name: /^Create drafts?$/ }).click()
  const card = page.getByRole("region", { name: "Generation results", exact: true }).getByRole("listitem").filter({ has: page.getByRole("heading", { name: "Course", level: 3, exact: true }) })
  await expect(card).toContainText("Course draft ready")
  await expect.poll(async () => JSON.parse((await stored(page))!).batch?.results[0]?.status).toBe("completed")
  await activate(card.getByRole("button", { name: "Preview Course", exact: true }), mobile)
  await expect(page.getByRole("heading", { name: TITLE, level: 1, exact: true })).toBeVisible()
  await expect(downloadUI(page).getByRole("button", { name: "Download Course HTML", exact: true })).toBeVisible()
}
async function saveNativeFile(page: Page, mobile: boolean, testInfo: TestInfo) {
  const link = downloadUI(page).getByRole("link", { name: "Save Course HTML", exact: true })
  await expect(link).toHaveAttribute("download", FILENAME)
  const href = await link.getAttribute("href")
  if (!href?.startsWith(`blob:${ORIGIN}/`)) throw new Error("Expected an owned local Blob URL")
  harnesses.get(page.context())!.blobs.add(href)
  const pending = page.waitForEvent("download")
  await activate(link, mobile)
  const download = await pending
  expect(download.suggestedFilename()).toBe(FILENAME); expect(download.suggestedFilename()).not.toMatch(/[\\/\r\n]/)
  const root = ownedDownloadRoot(); mkdirSync(root, { recursive: true })
  const directory = mkdtempSync(path.join(root, testInfo.project.name + "-"))
  harnesses.get(page.context())!.directories.push(directory)
  const file = path.join(directory, "saved-course.html")
  await download.saveAs(file); expect(await download.failure()).toBeNull()
  const html = readFileSync(file, "utf8")
  expect(html).toMatch(/^<!doctype html>/); expect(html).toMatch(/<script>/); expect(html).not.toMatch(/<script[^>]+src\s*=/i)
  expect(html).not.toMatch(/sendBeacon|localStorage|sessionStorage/)
  console.info(`Owned ${testInfo.project.name} Course ${download.suggestedFilename()} SHA256 ${createHash("sha256").update(html).digest("hex")}`)
  return file
}
async function standaloneFile(browser: Browser, appPage: Page, file: string, mobile: boolean) {
  const state = harnesses.get(appPage.context())!, fileURL = pathToFileURL(file).href
  const context = await browser.newContext({ javaScriptEnabled: true, serviceWorkers: "block", acceptDownloads: false, storageState: { cookies: [], origins: [] }, viewport: { width: mobile ? 390 : 1440, height: mobile ? 844 : 1000 }, isMobile: mobile, hasTouch: mobile })
  state.fileContexts.push(context); expect(await context.cookies()).toEqual([])
  await context.exposeBinding("courseRuntimeViolation", (_source, kind: unknown) => { state.unexpected.push(`Standalone runtime ${String(kind)}`) })
  await context.addInitScript(() => {
    // Attempts fail visibly and are retained in Node. These are tripwires, not
    // fake successful network/storage adapters. Reload installs them again.
    const forbidden = (kind: string) => {
      void (globalThis as typeof globalThis & { courseRuntimeViolation(kind: string): Promise<void> }).courseRuntimeViolation(kind)
      throw new Error("Forbidden standalone runtime side effect: " + kind)
    }
    for (const name of ["setItem", "removeItem", "clear"] as const) Object.defineProperty(Storage.prototype, name, { configurable: true, value: () => forbidden("storage:" + name) })
    Object.defineProperty(navigator, "sendBeacon", { configurable: true, value: () => forbidden("sendBeacon") })
    Object.defineProperty(globalThis, "fetch", { configurable: true, value: () => forbidden("fetch") })
    Object.defineProperty(XMLHttpRequest.prototype, "open", { configurable: true, value: () => forbidden("XMLHttpRequest") })
    for (const name of ["WebSocket", "EventSource"] as const) Object.defineProperty(globalThis, name, { configurable: true, value: function () { return forbidden(name) } })
  })
  await context.route("**/*", async (route) => {
    if (route.request().url() === fileURL && ["GET", "HEAD"].includes(route.request().method())) { await route.continue(); return }
    state.unexpected.push(`Standalone ${route.request().method()} ${route.request().url()}`); await route.abort("blockedbyclient")
  })
  const page = await context.newPage()
  page.on("pageerror", (error) => state.pageErrors.push("Standalone: " + error.message))
  await page.goto(fileURL, { waitUntil: "load" }); expect(page.url()).toBe(fileURL)
  return page
}

test("native Course HTML export retains authored content and its local interactive runtime across a file reload", async ({ page, browser }, testInfo) => {
  const mobile = testInfo.project.name === "mobile"
  await generateAndOpen(page, mobile)
  const before = await stored(page)
  await activate(downloadUI(page).getByRole("button", { name: "Download Course HTML", exact: true }), mobile)
  const file = await saveNativeFile(page, mobile, testInfo), standalone = await standaloneFile(browser, page, file, mobile)
  await expect(standalone.getByRole("heading", { name: TITLE, level: 1, exact: true })).toBeVisible()
  for (const text of ["Authored standalone Course subtitle", "Authored Course summary.", "Authored learning mission", "Authored learning objective", "Authored course prerequisite", "Authored assumed knowledge", "Authored learner goal", "Authored learner constraint", "Authored module objective", "Authored first lesson objective", "Authored first explanation", "Authored first lesson feedback", "Authored first lesson summary", "Authored second lesson objective", "Authored second explanation", "Authored second lesson feedback", "Authored second lesson summary", "Authored block heading", "Authored prose with <literal> text.", "Authored callout title", "Authored callout body", "Authored recall guidance", "Authored block takeaway", "Authored practice task", "RFC notes supplied as plain citation", "Authored glossary term", "Authored glossary definition", "Authored reference qualification"]) await expect(standalone.getByText(text, { exact: true })).toBeVisible()
  await expect(standalone.locator('.course-overview')).toContainText("Authored learner audience")
  await expect(standalone.locator('.course-overview')).toContainText("Authored course-level goal")
  await expect(standalone.locator('.course-overview')).toContainText("1 modules · 2 lessons · about 13 minutes · intermediate")
  await expect(standalone.locator('.lesson-header').first()).toContainText("5 min")
  await expect(standalone.locator('.lesson-header').last()).toContainText("8 min")
  await expect(standalone.locator('.quiz')).toHaveCount(1); await expect(standalone.locator('.recall')).toHaveCount(1)
  await expect(standalone.locator('.practice')).toContainText("Authored practice task")
  await expect(standalone.locator('.summary')).toContainText("Authored block takeaway")
  const ids = await standalone.locator('[id]').evaluateAll((elements) => elements.map((element) => element.id))
  expect(new Set(ids).size).toBe(ids.length); expect(ids.every((id) => /^[a-z][a-z0-9-]+$/.test(id))).toBe(true)
  for (const link of await standalone.locator('a[href^="#"]').all()) {
    const href = await link.getAttribute("href")
    expect(href).toMatch(/^#[a-z][a-z0-9-]+$/); await expect(standalone.locator(href!)).toHaveCount(1)
  }
  const dependency = standalone.locator('.lesson').last().getByRole("link", { name: "Authored foundations lesson", exact: true })
  await activate(dependency, mobile)
  expect(new URL(standalone.url()).hash).toBe(await dependency.getAttribute("href"))
  const linkedCitation = standalone.locator('.lesson').first().getByRole("link", { name: "Authored linked reference", exact: true })
  await expect(linkedCitation).toHaveAttribute("href", /^#course-node-/)
  const external = standalone.locator('.course-references').getByRole("link", { name: "Authored linked reference", exact: true })
  await expect(external).toHaveAttribute("href", "https://example.invalid/authored-reference?source=course")
  await expect(external).toHaveAttribute("rel", "noopener noreferrer")
  const quiz = standalone.locator('.quiz')
  await activate(quiz.getByRole("radio", { name: "Wrong authored choice", exact: true }), mobile)
  await expect(quiz.getByRole("status")).toHaveText("Try again. Authored answer explanation")
  await activate(quiz.getByRole("radio", { name: "Right authored choice", exact: true }), mobile)
  await expect(quiz.getByRole("status")).toHaveText("Correct. Authored answer explanation")
  const recall = standalone.getByRole("textbox", { name: "Explain the authored concept", exact: true })
  await recall.fill("My authored recall response"); await expect(recall).toHaveValue("My authored recall response")
  const complete = standalone.locator('.lesson').first().locator('.complete-lesson')
  await activate(complete, mobile); await expect(complete).toHaveText("Completed"); await expect(complete).toHaveAttribute("aria-pressed", "true")
  await standalone.reload({ waitUntil: "load" })
  await expect(standalone.locator('.quiz .feedback')).toBeHidden()
  // Completion is the runtime-owned in-memory state. Native form restoration
  // varies by browser and is not treated as application persistence here.
  await expect(standalone.locator('.lesson').first().getByRole("button", { name: "Mark complete", exact: true })).toHaveAttribute("aria-pressed", "false")
  expect(await stored(page)).toBe(before)
})

test("failed Course preparation preserves the stored draft and Retry calls the real local artifact route", async ({ page }, testInfo) => {
  const mobile = testInfo.project.name === "mobile", state = harnesses.get(page.context())!
  state.failFirst = true
  await generateAndOpen(page, mobile)
  const before = await stored(page), controls = downloadUI(page)
  await activate(controls.getByRole("button", { name: "Download Course HTML", exact: true }), mobile)
  await expect(controls.getByRole("alert")).toContainText("Your draft is still available")
  await expect(controls.getByRole("button", { name: "Retry Course HTML", exact: true })).toBeEnabled()
  await expect(controls.getByRole("link", { name: "Save Course HTML", exact: true })).toHaveCount(0)
  expect(await stored(page)).toBe(before)
  await expect(page.getByRole("heading", { name: TITLE, level: 1, exact: true })).toBeVisible()
  await activate(controls.getByRole("button", { name: "Retry Course HTML", exact: true }), mobile)
  await expect(controls.getByRole("alert")).toHaveCount(0)
  const file = await saveNativeFile(page, mobile, testInfo)
  expect(readFileSync(file, "utf8")).toContain("Authored first lesson feedback")
  expect(await stored(page)).toBe(before)
  expect(state.artifacts).toBe(2); expect(state.actualArtifacts).toBe(1); expect(state.mocked503).toBe(1)
})
